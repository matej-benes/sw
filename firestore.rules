rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Obecná pravidla - Povolit přístup pouze přihlášeným uživatelům.
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /tridy/{tridaId} {
      allow read, write: if request.auth != null;
    }
    match /predmety/{predmetId} {
        allow read, write: if request.auth != null;
    }
    match /ucebny/{ucebnaId} {
        allow read, write: if request.auth != null;
    }
     match /znamky/{znamkaId} {
        allow read, write: if request.auth != null;
    }
    match /rozvrhy/{rozvrhId} {
        allow read, write: if request.auth != null;
    }
    match /scheduleTemplates/{templateId} {
        allow read, write: if request.auth != null;
    }
    match /oznameni/{oznameniId} {
        allow read, write: if request.auth != null;
    }
    match /poznamky-zaku/{poznamkaId} {
        allow read, write: if request.auth != null;
    }
    match /udalosti/{udalostId} {
        allow read, write: if request.auth != null;
    }
    match /suplovani/{substitutionId} {
        allow read, write: if request.auth != null;
    }

    // Zabezpečená pravidla pro kolekci 'messages'
    match /messages/{messageId} {
    
      // Uživatel může číst (get) konkrétní dokument, pokud je odesílatelem nebo je v seznamu příjemců.
      allow get: if request.auth != null && 
                   (request.auth.uid == resource.data.senderId || request.auth.uid in resource.data.recipientIds);

      // Uživatel může vypisovat (list) zprávy, pouze pokud dotaz explicitně filtruje zprávy, kde je příjemcem NEBO odesílatelem.
      // Toto pravidlo je klíčové pro bezpečné načítání doručených i odeslaných zpráv.
      allow list: if request.auth != null && 
                  (request.query.where[0][0] == 'recipientIds' && request.query.where[0][1] == 'array-contains' && request.query.where[0][2] == request.auth.uid) ||
                  (request.query.where[0][0] == 'senderId' && request.query.where[0][1] == '==' && request.query.where[0][2] == request.auth.uid);

      // Kdo může vytvářet zprávy?
      // Jakýkoliv přihlášený uživatel, pokud je ID odesílatele shodné s jeho vlastním ID.
      // Zároveň text zprávy nesmí být prázdný a seznam příjemců musí existovat.
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.senderId &&
                     request.resource.data.text is string &&
                     request.resource.data.text.size() > 0 &&
                     request.resource.data.recipientIds is list;

      // Kdo může aktualizovat zprávy?
      // Uživatel může aktualizovat zprávu POUZE za účelem přidání svého ID do pole 'readBy'.
      // To umožňuje označit zprávu jako přečtenou, ale nic jiného měnit nelze.
      allow update: if request.auth != null &&
                     request.auth.uid in resource.data.recipientIds &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
                     request.auth.uid in request.resource.data.readBy;

      // Nikdo nemůže mazat zprávy.
      allow delete: if false;
    }
  }
}
