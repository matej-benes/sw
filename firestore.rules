
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isSuperAdmin() {
      // Super admin is identified by a specific claim or a field in their user document.
      // For this implementation, we check a field in their user document.
      return isAuthenticated() && getUserData(request.auth.uid).isSuperAdmin == true;
    }

    // Membership and Roles Functions
    function isMember(organizationId) {
      return isAuthenticated() && getUserData(request.auth.uid).memberships.exists(m, m.organizationId == organizationId);
    }
    
    function getMembership(organizationId) {
        return getUserData(request.auth.uid).memberships.filter(m, m.organizationId == organizationId)[0];
    }
    
    function hasRole(organizationId, role) {
       return isMember(organizationId) && getMembership(organizationId).roles.hasAny([role]);
    }
    
    function hasAnyRole(organizationId, roles) {
       return isMember(organizationId) && getMembership(organizationId).roles.hasAny(roles);
    }
    
    function isOrganizationOwner(organizationId) {
        // This function checks the OWNER of the organization document in Firestore, NOT the incoming request.
        // It's used for rules where an existing owner needs to be verified.
        let orgDoc = get(/databases/$(database)/documents/organizations/$(organizationId));
        return isAuthenticated() && orgDoc.data.ownerId == request.auth.uid;
    }

    // Rules for specific top-level collections
    match /organizations/{organizationId} {
      // ANYONE can read organization data to verify registration PINs.
      allow read: if true; 
      // Only Super Admins can create or delete organizations.
      allow create, delete: if isSuperAdmin();
      // An update is allowed by a Super Admin OR by a user who is becoming the new owner.
      // `request.resource.data.ownerId` refers to the state of the document AFTER the update.
      allow update: if isSuperAdmin() || (isAuthenticated() && request.resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId} {
      // ANYONE can list/read user data to verify PINs for registration.
      // This is safe because sensitive data should not be in the user doc itself.
      allow read: if true; 
      // ANYONE can create a user document (as part of registration).
      allow create: if true;
      // ANYONE can delete a user document (the placeholder during registration).
      allow delete: if true;
      // Only the owner or a super admin can update a user document.
      allow update: if isOwner(userId) || isSuperAdmin();
    }
    
    // Default rules for collections within an organization
    match /{collection}/{docId} {
       // This rule applies to any document that has an 'organizationId' field.
       // It's a broad rule for documents inside an organization's scope.
       
       // Allow READ access if:
       // 1. The document has an organizationId field.
       // 2. The requesting user is a member of that organization.
       allow read: if resource.data.keys().hasAny(['organizationId']) &&
                    isMember(resource.data.organizationId);

       // Allow WRITE access if:
       // 1. The document has an organizationId field.
       // 2. The user is the owner of the organization OR has an 'administrator' or 'ucitel' role.
       allow write: if resource.data.keys().hasAny(['organizationId']) &&
                    (isOrganizationOwner(resource.data.organizationId) ||
                     hasAnyRole(resource.data.organizationId, ['administrator', 'ucitel']));

       // Fallback for list queries where 'resource' is not available.
       // This allows any authenticated user to list documents, but the 'read' rule above
       // will still protect the actual content of each document.
       allow list: if isAuthenticated();
    }
    
    // Specific override for messages
    match /messages/{messageId} {
      allow get: if isAuthenticated() && (resource.data.senderId == request.auth.uid || request.auth.uid in resource.data.recipientIds);
      // Any member of an org can create a message within that org's context.
      allow create: if isAuthenticated() && isMember(request.resource.data.organizationId);
      // Only recipients can "update" a message (e.g., mark as read).
      allow update: if isAuthenticated() && request.auth.uid in resource.data.recipientIds;
      allow delete: if false; // Disallow deleting messages.
    }
  }
}
