
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the sender
    function isSender(message) {
      return request.auth.uid == message.senderId;
    }

    // Helper function to check if user is a recipient
    function isRecipient() {
      return request.auth.uid in resource.data.recipientIds;
    }

    // Default secure rules for all other collections
    match /{path=**}/documents {
      allow read, write: if isAuthenticated();
    }

    // Specific and secure rules for the 'messages' collection
    match /messages/{messageId} {
      // READ: Allow if user is sender OR is in the recipients list.
      // This covers both 'get' and 'list' operations securely.
      // For 'list', Firestore checks this rule against the query's constraints.
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid in resource.data.recipientIds);

      // CREATE: Allow if the user is authenticated and is the sender of the message.
      allow create: if isAuthenticated() && isSender(request.resource.data);

      // UPDATE: Allow sender to update their own message.
      // Example: To allow recipients to mark as read, a more granular rule would be needed.
      allow update: if isAuthenticated() && isSender(resource.data);

      // DELETE: For safety, don't allow deletion, but if needed, only the sender should be able to.
      allow delete: if isAuthenticated() && isSender(resource.data);
    }
  }
}
