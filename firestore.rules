
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- POMOCNÉ FUNKCE (HELPER FUNCTIONS) ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().roles.hasAny([role]);
    }
    
    function hasAnyRole(roles) {
      return isSignedIn() && getUserData().roles.hasAny(roles);
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().isSuperAdmin == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMyStudent(studentId) {
        let parentData = getUserData();
        return hasRole('rodic') && parentData.studentId == studentId;
    }

    // --- PRAVIDLA PRO KOLEKCE ---

    match /users/{userId} {
      allow get: if isOwner(userId) || hasRole('administrator');
      allow list: if hasRole('administrator');
      allow create: if hasRole('administrator') || (request.auth != null && request.auth.uid == userId);
      allow update: if isOwner(userId) || hasRole('administrator');
      allow delete: if isOwner(userId) || hasRole('administrator');
    }
    
    match /pins/{pinId} {
      allow get: if true;
      allow create, delete: if hasRole('administrator');
      allow list, update: if false;
    }
    
    match /organizations/{organizationId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /grades/{gradeId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin() || isSuperAdmin();
    }

    match /tridy/{classId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin() || isSuperAdmin();
    }
    
    match /predmety/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin() || isSuperAdmin();
    }
    
    match /ucebny/{ucebnaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    match /poznamky-zaku/{poznamkaId} {
        allow read: if isSignedIn();
        allow write: if isTeacher() || isAdmin() || isSuperAdmin();
    }
    
    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }
    
    match /rozvrhy/{rozvrhId} {
        allow read, write: if isSignedIn();
    }
    
    match /scheduleTemplates/{templateId} {
        allow read, write: if isSignedIn();
    }
    
    match /udalosti/{udalostId} {
        allow read, write: if isSignedIn();
    }
    
    match /suplovani/{substitutionId} {
        allow read, write: if isSignedIn();
    }
    
    match /zapisyHodin/{zapisId} {
        allow read, write: if isSignedIn();
    }
    
    match /absences/{absenceId} {
        allow read, write: if isSignedIn();
    }
    
    match /omluvenky/{omluvenkaId} {
        allow read, write: if isSignedIn();
    }
    
    match /ukoly/{ukolId} {
        allow read, write: if isSignedIn();
    }
    
    match /prijimaci-rizeni/{rizeniId} {
        allow create: if true; // Veřejný formulář
        allow read, update, delete: if isAdmin() || isSuperAdmin();
    }
    
    match /zaznamy-schuzek/{zaznamId} {
        allow read, write: if isSignedIn();
    }
    
     match /oznameni/{oznameniId} {
        allow read, write: if isSignedIn();
    }
  }
}
