
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- POMOCNÉ FUNKCE (HELPER FUNCTIONS) ---

    // 1. Zkontroluje, zda je uživatel přihlášen
    function isSignedIn() {
      return request.auth != null;
    }

    // 2. Získá data o uživateli z databáze (pro kontrolu rolí)
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 3. Zkontroluje, zda má uživatel konkrétní roli
    function hasRole(role) {
      // Správná kontrola pro pole 'roles'
      return isSignedIn() && getUserData().roles.hasAny([role]);
    }
    
    // 3.1 Zkontroluje, zda má uživatel alespoň jednu z rolí v seznamu
    function hasAnyRole(roles) {
      return isSignedIn() && getUserData().roles.hasAny(roles);
    }

    // 4. Zkontroluje, zda je uživatel administrátor
    function isAdmin() {
      // Používá správný název role 'administrator'
      return hasRole('administrator');
    }
    
    // 4.1 Zkontroluje, zda je uživatel Super Administrátor
    function isSuperAdmin() {
      return isSignedIn() && getUserData().isSuperAdmin == true;
    }

    // 5. Zkontroluje, zda je uživatel učitel
    function isTeacher() {
      // Používá správný název role 'ucitel'
      return hasRole('ucitel');
    }
    
    // 6. Zkontroluje, zda je rodič a ID studenta se shoduje
    function isMyStudent(studentId) {
        let parentData = getUserData();
        return hasRole('rodic') && parentData.studentId == studentId;
    }

    // --- PRAVIDLA PRO KOLEKCE ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin() || request.auth.uid == userId;
    }
    
    match /organizations/{organizationId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /grades/{gradeId} {
      // Čtení: Admin/SuperAdmin vidí vše v rámci své organizace. Učitel vidí známky, které zadal. Žák/Rodič vidí své/svého dítěte.
      allow read: if isSignedIn();
      // Zápis/Úprava: Jen učitelé, admini a superadmini
      allow write: if isTeacher() || isAdmin() || isSuperAdmin();
    }

    match /tridy/{classId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin() || isSuperAdmin();
    }
    
    match /predmety/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin() || isSuperAdmin();
    }
    
    match /ucebny/{ucebnaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    match /poznamky-zaku/{poznamkaId} {
        allow read: if isSignedIn();
        allow write: if isTeacher() || isAdmin() || isSuperAdmin();
    }
    
    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }
    
    match /rozvrhy/{rozvrhId} {
        allow read, write: if isSignedIn();
    }
    
    match /scheduleTemplates/{templateId} {
        allow read, write: if isSignedIn();
    }
    
    match /udalosti/{udalostId} {
        allow read, write: if isSignedIn();
    }
    
    match /suplovani/{substitutionId} {
        allow read, write: if isSignedIn();
    }
    
    match /zapisyHodin/{zapisId} {
        allow read, write: if isSignedIn();
    }
    
    match /absences/{absenceId} {
        allow read, write: if isSignedIn();
    }
    
    match /omluvenky/{omluvenkaId} {
        allow read, write: if isSignedIn();
    }
    
    match /ukoly/{ukolId} {
        allow read, write: if isSignedIn();
    }
    
    match /prijimaci-rizeni/{rizeniId} {
        allow create: if true; // Veřejný formulář
        allow read, update, delete: if isAdmin() || isSuperAdmin();
    }
    
    match /zaznamy-schuzek/{zaznamId} {
        allow read, write: if isSignedIn();
    }
    
     match /oznameni/{oznameniId} {
        allow read, write: if isSignedIn();
    }
  }
}
