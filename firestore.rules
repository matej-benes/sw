
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is the owner of a document (generic)
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for 'users' collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Rules for 'tridy' collection
    match /tridy/{tridaId} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Rules for 'predmety' collection
    match /predmety/{predmetId} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Rules for 'ucebny' collection
    match /ucebny/{ucebnaId} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Rules for 'rozvrhy' collection
    match /rozvrhy/{rozvrhId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
    
    // Rules for 'scheduleTemplates' collection
    match /scheduleTemplates/{templateId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
     
     // Rules for 'oznameni' collection
     match /oznameni/{oznameniId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
    
    // Rules for 'poznamky-zaku' collection
    match /poznamky-zaku/{poznamkaId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
    
    // Rules for 'udalosti' collection
    match /udalosti/{udalostId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
     
     // Rules for 'suplovani' collection
     match /suplovani/{substitutionId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
    
    // Rules for 'znamky' subcollection
    match /users/{userId}/znamky/{znamkaId} {
       allow get, list: if isAuthenticated();
       allow write: if isAuthenticated();
    }

    // Specific and secure rules for the 'messages' collection
    match /messages/{messageId} {
      // Allow reading a single message if the user is the sender or a recipient.
      allow get: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid in resource.data.recipientIds);
      
      // Allow listing messages only for authenticated users. 
      // The client-side query MUST then filter for the user's specific messages.
      allow list: if isAuthenticated();
      
      // Allow creating a message if the senderId matches the user's UID.
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      
      // Allow a recipient to update the 'readBy' field to mark a message as read.
      // The sender cannot update anything.
      allow update: if isAuthenticated() && 
                    (request.auth.uid in resource.data.recipientIds && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
                     
      // Disallow deleting messages to preserve communication history.
      allow delete: if false; 
    }
  }
}
