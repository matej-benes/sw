
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pravidla pro ostatní kolekce
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /tridy/{tridaId} {
      allow read, write: if request.auth != null;
    }
    match /predmety/{predmetId} {
      allow read, write: if request.auth != null;
    }
    match /ucebny/{ucebnaId} {
      allow read, write: if request.auth != null;
    }
     match /znamky/{znamkaId} {
      allow read, write: if request.auth != null;
    }
    match /rozvrhy/{rozvrhId} {
      allow read, write: if request.auth != null;
    }
    match /scheduleTemplates/{templateId} {
      allow read, write: if request.auth != null;
    }
    match /oznameni/{oznameniId} {
      allow read, write: if request.auth != null;
    }
    match /poznamky-zaku/{poznamkaId} {
      allow read, write: if request.auth != null;
    }
    match /udalosti/{udalostId} {
      allow read, write: if request.auth != null;
    }
    match /suplovani/{substitutionId} {
      allow read, write: if request.auth != null;
    }
    
    // Pravidla pro kolekci 'messages' dle vašeho zadání
    match /messages/{messageId} {
      allow list, get: if request.auth != null;
      allow create: if request.auth != null;
      // Poznámka: Ujistěte se, že dokumenty zpráv obsahují pole 'userId' se shodným UID odesílatele,
      // jinak update/delete selže. Ve vaší struktuře se pole jmenuje 'senderId'.
      allow update, delete: if resource == null || resource.data.senderId == request.auth.uid;
    }
  }
}
