
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for 'users' collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Rules for 'tridy' collection
    match /tridy/{tridaId} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Rules for 'predmety' collection
    match /predmety/{predmetId} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Rules for 'ucebny' collection
    match /ucebny/{ucebnaId} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Rules for 'rozvrhy' collection
    match /rozvrhy/{rozvrhId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
    
    // Rules for 'scheduleTemplates' collection
    match /scheduleTemplates/{templateId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
     
     // Rules for 'oznameni' collection
     match /oznameni/{oznameniId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
    
    // Rules for 'poznamky-zaku' collection
    match /poznamky-zaku/{poznamkaId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
    
    // Rules for 'udalosti' collection
    match /udalosti/{udalostId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
     
     // Rules for 'suplovani' collection
     match /suplovani/{substitutionId} {
        allow get, list: if isAuthenticated();
        allow write: if isAuthenticated();
    }
    
    // Rules for 'znamky' subcollection
    match /users/{userId}/znamky/{znamkaId} {
       allow get, list: if isAuthenticated();
       allow write: if isAuthenticated();
    }


    // Specific and secure rules for the 'messages' collection
    match /messages/{messageId} {
      allow get: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid in resource.data.recipientIds);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && 
                    (request.auth.uid == resource.data.senderId ||
                     (request.auth.uid in resource.data.recipientIds && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])));
      allow delete: if false; 
    }
  }
}
