
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserData(request.auth.uid).isSuperAdmin == true;
    }

    function isMember(organizationId) {
      return isAuthenticated() && getUserData(request.auth.uid).memberships.exists(m, m.organizationId == organizationId);
    }
    
    function getMembership(organizationId) {
        return getUserData(request.auth.uid).memberships.filter(m, m.organizationId == organizationId)[0];
    }
    
    function hasRole(organizationId, role) {
       return isMember(organizationId) && getMembership(organizationId).roles.hasAny([role]);
    }
    
    function hasAnyRole(organizationId, roles) {
       return isMember(organizationId) && getMembership(organizationId).roles.hasAny(roles);
    }
    
    function isOrganizationOwner(organizationId) {
        return isAuthenticated() && get(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerId == request.auth.uid;
    }

    match /organizations/{organizationId} {
      allow read: if isMember(organizationId) || isSuperAdmin();
      allow create: if isAuthenticated() && isSuperAdmin();
      allow update, delete: if isOrganizationOwner(organizationId) || isSuperAdmin();
      allow list: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isAuthenticated() || isSuperAdmin();
      allow update: if isOwner(userId) || isSuperAdmin();
      allow create, delete, list: if isSuperAdmin();
    }
    
    match /{collection}/{docId} {
       // Org-scoped rules for members with specific roles (administrator, teacher)
       allow read, write: if request.resource.data.keys().hasAny(['organizationId']) &&
                           (hasAnyRole(request.resource.data.organizationId, ['administrator', 'ucitel']) || 
                            isOrganizationOwner(request.resource.data.organizationId));
       
       // General read-only rule for any member of the organization
       allow read: if request.resource.data.keys().hasAny(['organizationId']) && isMember(request.resource.data.organizationId);

       // Fallback for list queries where resource is not available.
       // This is less secure but might be necessary for certain UI components.
       // It allows any authenticated user to list documents, but the 'read' rules above will still protect the actual content.
       allow list: if isAuthenticated();
    }
    
    match /messages/{messageId} {
      allow get: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid in resource.data.recipientIds);
      allow create: if isAuthenticated() && isMember(request.resource.data.organizationId);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.recipientIds);
      allow delete: if false; 
    }
  }
}
