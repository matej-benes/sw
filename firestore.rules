
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['administrator']);
    }
    
    function isClassTeacher(classId) {
        let classDoc = get(/databases/$(database)/documents/tridy/$(classId));
        return classDoc.data.ucitelId == request.auth.uid || request.auth.uid in classDoc.data.zastupciIds;
    }
    
     function isMyStudent(studentId) {
        let parentData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return parentData.roles.hasAny(['rodic']) && parentData.studentId == studentId;
    }
    
    function hasAnyRole(roles) {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(roles);
    }
    
    function isMyClassStudent(studentId) {
        let studentDoc = get(/databases/$(database)/documents/users/$(studentId));
        let studentClassId = studentDoc.data.tridaId;
        // Check if student has a class and if the requesting user is a teacher of that class
        return studentClassId != null && isClassTeacher(studentClassId);
    }

    match /users/{userId} {
      allow get, list: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Gradings are now stored in a subcollection of the user who created them (the teacher)
      match /gradings/{gradingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // This subcollection is now deprecated.
      match /znamky/{znamkaId} {
         allow read, write: if false;
      }
    }
    
    match /tridy/{tridaId} {
      allow get, list: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /predmety/{predmetId} {
      allow get, list: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /ucebny/{ucebnaId} {
      allow get, list: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /rozvrhy/{rozvrhId} {
        allow get, list: if isAuthenticated();
        allow write: if isAdmin();
    }
    
    match /scheduleTemplates/{templateId} {
        allow get, list: if isAuthenticated();
        allow write: if isAdmin();
    }
     
     match /oznameni/{oznameniId} {
        allow get, list: if isAuthenticated();
        allow write: if isAdmin() || hasAnyRole(['ucitel']);
    }
    
    match /poznamky-zaku/{poznamkaId} {
        allow get, list: if isAuthenticated();
        allow write: if isAdmin() || hasAnyRole(['ucitel']);
    }
    
    match /udalosti/{udalostId} {
        allow get, list: if isAuthenticated();
        allow create, delete: if isAdmin();
    }
     
     match /suplovani/{substitutionId} {
        allow get, list: if isAuthenticated();
        allow write: if isAdmin();
    }
    
    match /messages/{messageId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid in resource.data.recipientIds);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.recipientIds && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if false; 
    }

    match /zapisyHodin/{zapisId} {
        allow get, list: if isAuthenticated() && (hasAnyRole(['ucitel', 'administrator', 'ziak', 'rodic']));
        allow write: if isAdmin() || hasAnyRole(['ucitel']);
    }

    match /absences/{absenceId} {
        allow get, list, create, update, delete: if isAdmin();
    }
    
    match /omluvenky/{omluvenkaId} {
        allow get: if isAuthenticated() && (isMyStudent(resource.data.studentId) || isClassTeacher(resource.data.tridaId) || isAdmin());
        allow list: if isAuthenticated();
        allow create: if isAuthenticated() && isMyStudent(request.resource.data.studentId);
        allow update: if isAuthenticated() && (isClassTeacher(request.resource.data.tridaId) || isAdmin());
        allow delete: if false;
    }
    
    match /ukoly/{ukolId} {
        allow get, list: if isAuthenticated();
        allow create, update, delete: if isAdmin() || hasAnyRole(['ucitel']);
    }

    match /zapisy/{zapisId} {
        allow get, list, write: if isAdmin();
    }
  }
}
