
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      // Use exists() for safer checking
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }
    
    function getUserData() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().roles.hasAny([role]);
    }

    function hasAnyRole(roles) {
      return isAuthenticated() && getUserData().roles.hasAny(roles);
    }
    
    function isMyStudent(studentId) {
        let parentData = getUserData();
        return parentData.roles.hasAny(['rodic']) && parentData.studentId == studentId;
    }
    
    // Per-Collection Rules

    match /users/{userId} {
      allow read, create: if true;
      allow update: if isOwner(userId) || hasRole('administrator');
      allow delete: if isOwner(userId) || hasRole('administrator');
    }
    
    match /grades/{gradeId} {
      allow get: if isAuthenticated() && (hasAnyRole(['ucitel', 'administrator']) || resource.data.ziakId == request.auth.uid || isMyStudent(resource.data.ziakId));
      allow list: if 
          (hasRole('administrator') && request.query.organizationId == getUserData().organizationId) ||
          (hasRole('ucitel') && request.query.ucitelId == request.auth.uid) ||
          (hasRole('ziak') && request.query.ziakId == request.auth.uid) ||
          (hasRole('rodic') && isMyStudent(request.query.ziakId));
      allow create, update, delete: if hasAnyRole(['ucitel', 'administrator']);
    }

    match /tridy/{tridaId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['administrator', 'ucitel']);
    }

    match /predmety/{predmetId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['administrator', 'ucitel']);
    }

    match /ucebny/{ucebnaId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['administrator', 'ucitel']);
    }

    match /rozvrhy/{rozvrhId} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /scheduleTemplates/{templateId} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }

    match /poznamky-zaku/{poznamkaId} {
        allow get: if isAuthenticated() && (
          hasAnyRole(['ucitel', 'administrator']) || 
          resource.data.studentId == request.auth.uid || 
          isMyStudent(resource.data.studentId)
        );
        allow list: if 
            (hasRole('administrator') && request.query.organizationId == getUserData().organizationId) ||
            (hasRole('ucitel') && request.query.ucitelId == request.auth.uid) ||
            (hasRole('ziak') && request.query.studentId == request.auth.uid) ||
            (hasRole('rodic') && isMyStudent(request.query.studentId));
        allow write: if hasAnyRole(['ucitel', 'administrator']);
    }

    match /udalosti/{udalostId} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /messages/{messageId} {
      allow create: if isAuthenticated();
      allow get: if isAuthenticated() && (resource.data.senderId == request.auth.uid || request.auth.uid in resource.data.recipientIds);
      allow list: if isAuthenticated() && (request.query.recipientIds.hasAny([request.auth.uid]) || request.query.senderId == request.auth.uid);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.recipientIds;
      allow delete: if false; 
    }

    match /zapisyHodin/{zapisId} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }

    match /absences/{absenceId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /omluvenky/{omluvenkaId} {
        allow read, write: if isAuthenticated();
    }
    
    match /ukoly/{ukolId} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }

    match /prijimaci-rizeni/{rizeniId} {
      allow create: if true;
      allow read, update, delete: if hasRole('administrator');
    }
    
    match /organizations/{organizationId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    match /zaznamy-schuzek/{zaznamId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
    match /oznameni/{oznameniId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
    match /suplovani/{substitutionId} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['administrator']);
    }
  }
}
