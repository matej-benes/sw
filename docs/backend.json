{
  "entities": {
    "Organization": {
      "title": "Organization",
      "type": "object",
      "description": "Represents a single organization, such as a school, a faculty, or a project group.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the organization." },
        "name": { "type": "string", "description": "The name of the organization." },
        "ownerId": { "type": "string", "description": "The user ID of the organization's owner." },
        "registrationPin": { "type": "string", "description": "A 6-digit PIN for initial director/admin registration." },
        "type": { "type": "string", "enum": ["skola", "zajmova_skupina"], "description": "The type of the organization." }
      },
      "required": ["id", "name", "ownerId", "type"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the system, potentially across multiple organizations.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user (matches Firebase Auth UID)." },
        "name": { "type": "string", "description": "The user's full name." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "roles": {
          "type": "array",
          "description": "An array of roles the user has within the school.",
          "items": { "type": "string" }
        },
        "studentId": { "type": "string", "description": "For parents, the ID of their child student. This assumes a parent is linked to one child per organization context." },
        "pin": { "type": "string", "description": "A 6-digit PIN for initial user registration." },
        "isSuperAdmin": { "type": "boolean", "description": "Indicates if the user is a super administrator." }
      },
      "required": ["id", "name", "email"]
    },
    "Grading": {
      "title": "Grading",
      "type": "object",
      "description": "Represents a single grade given to a student.",
      "properties": {
        "organizationId": { "type": "string" },
        "tridaId": { "type": "string" },
        "ziakId": { "type": "string" },
        "predmetId": { "type": "string" },
        "ucitelId": { "type": "string" },
        "ziakJmeno": { "type": "string" },
        "predmet": { "type": "string" },
        "znamka": { "type": "number" },
        "vaha": { "type": "number" },
        "komentar": { "type": "string" },
        "datum": { "type": "string", "format": "date" },
        "cas": { "type": "string", "format": "time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["organizationId", "tridaId", "ziakId", "predmetId", "ucitelId", "ziakJmeno", "predmet", "znamka", "vaha", "datum", "cas", "createdAt"]
    },
    "Trida": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Trida",
      "type": "object",
      "description": "Represents a class (trida) within a specific organization.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the class." },
        "organizationId": { "type": "string", "description": "The ID of the organization this class belongs to." },
        "nazev": { "type": "string", "description": "The name of the class." },
        "ucitelId": { "type": "string", "description": "The ID of the teacher in charge of the class." },
        "zastupciIds": { "type": "array", "items": { "type": "string" } },
        "asistentiIds": { "type": "array", "items": { "type": "string" } },
        "ziaciIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "organizationId", "nazev", "ucitelId"]
    },
    "Rozvrh": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Rozvrh",
      "type": "object",
      "description": "Represents a class schedule for a specific day and class within an organization.",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "tridaId": { "type": "string" },
        "datum": { "type": "string", "format": "date" },
        "hodiny": { "type": "array", "items": { "oneOf": [{ "$ref": "#/backend/entities/LessonBlock" }, { "type": "null" }] } },
        "timeSlots": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "organizationId", "tridaId", "datum", "hodiny", "timeSlots"]
    },
    "ScheduleTemplate": {
        "title": "ScheduleTemplate",
        "type": "object",
        "description": "A template for a class's weekly schedule within an organization.",
        "properties": {
            "id": { "type": "string" },
            "organizationId": { "type": "string" },
            "tridaId": { "type": "string" },
            "timeSlots": { "type": "array", "items": { "type": "string" } },
            "days": { "type": "array", "items": { "$ref": "#/backend/entities/StorableDay" } }
        },
        "required": ["id", "organizationId", "tridaId", "timeSlots", "days"]
    },
    "Predmet": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Predmet",
      "type": "object",
      "description": "Represents a subject taught in an organization.",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "shortcut": { "type": "string" },
        "teacherCount": { "type": "number" }
      },
      "required": ["id", "organizationId", "name", "shortcut"]
    },
    "Ucebna": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Ucebna",
      "type": "object",
      "description": "Represents a classroom in an organization.",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "nazev": { "type": "string" },
        "kapacita": { "type": "number" }
      },
      "required": ["id", "organizationId", "nazev"]
    },
     "PoznamkaZaka": {
      "title": "PoznamkaZaka",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "studentId": { "type": "string" },
        "tridaId": { "type": "string" },
        "predmet": { "type": "string" },
        "datum": { "type": "string", "format": "date-time" },
        "druh": { "type": "string" },
        "text": { "type": "string" },
        "ucitelId": { "type": "string" },
        "datumPodpisu": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "organizationId", "studentId", "tridaId", "datum", "druh", "text", "ucitelId"]
    },
    "Udalost": {
        "title": "Udalost",
        "type": "object",
        "properties": {
            "id": { "type": "string" },
            "organizationId": { "type": "string" },
            "nazev": { "type": "string" },
            "typ": { "type": "string" },
            "datum": { "type": "string", "format": "date" },
            "cas": { "type": "string", "format": "time" },
            "tridyIds": { "type": "array", "items": { "type": "string" } },
            "uciteleIds": { "type": "array", "items": { "type": "string" } },
            "nahrazujeHodiny": { "type": "boolean" }
        },
        "required": ["id", "organizationId", "nazev", "typ", "datum", "cas"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientIds": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "organizationId", "senderId", "recipientIds", "text", "createdAt"]
    },
    "ZapisHodiny": {
        "title": "ZapisHodiny",
        "type": "object",
        "properties": {
            "id": { "type": "string" },
            "organizationId": { "type": "string" },
            "tridaId": { "type": "string" },
            "datum": { "type": "string", "format": "date" },
            "hodina": { "type": "string" },
            "predmetId": { "type": "string" },
            "ucitelId": { "type": "string" },
            "topic": { "type": "string" },
            "note": { "type": "string" },
            "attendance": { "type": "array", "items": { "type": "object", "properties": { "studentId": { "type": "string" }, "status": { "type": "string", "enum": ["-", "/", "O", "N", "S"] }, "reason": { "type": "string" } }, "required": ["studentId", "status"] } }
        },
        "required": ["id", "organizationId", "tridaId", "datum", "hodina", "predmetId", "ucitelId", "topic", "attendance"]
    },
     "Omluvenka": {
      "title": "Omluvenka",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "studentId": { "type": "string" },
        "parentId": { "type": "string" },
        "tridaId": { "type": "string" },
        "datumOd": { "type": "string", "format": "date" },
        "datumDo": { "type": "string", "format": "date" },
        "duvod": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "datumPodani": { "type": "string", "format": "date-time" },
        "vyjadreniUcitele": { "type": "string" }
      },
      "required": ["id", "organizationId", "studentId", "tridaId", "datumOd", "datumDo", "duvod", "status", "datumPodani"]
    },
    "DomaciUkol": {
      "title": "DomaciUkol",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "tridaId": { "type": "string" },
        "predmetId": { "type": "string" },
        "ucitelId": { "type": "string" },
        "nazev": { "type": "string" },
        "popis": { "type": "string" },
        "datumZadani": { "type": "string", "format": "date" },
        "terminOdevzdani": { "type": "string", "format": "date" },
        "prilohy": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "organizationId", "tridaId", "predmetId", "ucitelId", "nazev", "popis", "datumZadani", "terminOdevzdani"]
    },
     "PrijimaciRizeni": {
        "title": "PrijimaciRizeni",
        "type": "object",
        "description": "Represents an application for enrollment, scoped to an organization.",
        "properties": {
            "id": { "type": "string" },
            "organizationId": { "type": "string" },
            "jmenoDitete": { "type": "string" },
            "datumNarozeniDitete": { "type": "string", "format": "date" },
            "bydlisteDitete": { "type": "string" },
            "jmenoZastupce": { "type": "string" },
            "emailZastupce": { "type": "string", "format": "email" },
            "telefonZastupce": { "type": "string" },
            "datumPodani": { "type": "string", "format": "date-time" },
            "status": { "type": "string", "enum": ["Podáno", "Přijato", "Nepřijato", "Odklad"] }
        },
        "required": ["id", "organizationId", "jmenoDitete", "datumNarozeniDitete", "jmenoZastupce", "emailZastupce", "datumPodani", "status"]
    },
    "ZaznamSchuzky": {
      "title": "ZaznamSchuzky",
      "type": "object",
      "description": "Represents a meeting record for an interest group.",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "datum": { "type": "string", "format": "date" },
        "cas": { "type": "string", "format": "time" },
        "topic": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "organizationId", "datum", "cas", "topic", "createdBy"]
    },
    "LessonBlock": { "type": "object" },
    "StorableDay": { "type": "object" },
    "Substitution": { "type": "object" },
    "Oznameni": { "type": "object" },
    "Absence": {
      "title": "Absence",
      "type": "object",
      "description": "Represents a single period of absence for a student.",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "studentId": { "type": "string" },
        "tridaId": { "type": "string" },
        "datum": { "type": "string", "format": "date" },
        "hodina": { "type": "string" },
        "predmetId": { "type": "string" },
        "ucitelId": { "type": "string" },
        "status": { "type": "string", "enum": ["/", "O", "N", "S"], "description": "Status: neurčená, omluvená, neomluvená, nezapočítávaná" },
        "omluvenkaId": { "type": "string" }
      },
      "required": ["id", "organizationId", "studentId", "tridaId", "datum", "hodina", "predmetId", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/organizations/{organizationId}", "definition": { "schema": { "$ref": "#/backend/entities/Organization" } } },
      { "path": "/users/{userId}", "definition": { "schema": { "$ref": "#/backend/entities/User" } } },
      { "path": "/grades/{gradeId}", "definition": { "schema": { "$ref": "#/backend/entities/Grading" } } },
      { "path": "/tridy/{tridaId}", "definition": { "schema": { "$ref": "#/backend/entities/Trida" } } },
      { "path": "/predmety/{predmetId}", "definition": { "schema": { "$ref": "#/backend/entities/Predmet" } } },
      { "path": "/ucebny/{ucebnaId}", "definition": { "schema": { "$ref": "#/backend/entities/Ucebna" } } },
      { "path": "/rozvrhy/{rozvrhId}", "definition": { "schema": { "$ref": "#/backend/entities/Rozvrh" } } },
      { "path": "/scheduleTemplates/{templateId}", "definition": { "schema": { "$ref": "#/backend/entities/ScheduleTemplate" } } },
      { "path": "/poznamky-zaku/{poznamkaId}", "definition": { "schema": { "$ref": "#/backend/entities/PoznamkaZaka" } } },
      { "path": "/udalosti/{udalostId}", "definition": { "schema": { "$ref": "#/backend/entities/Udalost" } } },
      { "path": "/messages/{messageId}", "definition": { "schema": { "$ref": "#/backend/entities/Message" } } },
      { "path": "/zapisyHodin/{zapisId}", "definition": { "schema": { "$ref": "#/backend/entities/ZapisHodiny" } } },
      { "path": "/omluvenky/{omluvenkaId}", "definition": { "schema": { "$ref": "#/backend/entities/Omluvenka" } } },
      { "path": "/ukoly/{ukolId}", "definition": { "schema": { "$ref": "#/backend/entities/DomaciUkol" } } },
      { "path": "/prijimaci-rizeni/{rizeniId}", "definition": { "schema": { "$ref": "#/backend/entities/PrijimaciRizeni" } } },
      { "path": "/zaznamy-schuzek/{zaznamId}", "definition": { "schema": { "$ref": "#/backend/entities/ZaznamSchuzky" } } },
      { "path": "/absences/{absenceId}", "definition": { "schema": { "$ref": "#/backend/entities/Absence" } } }
    ]
  }
}
