rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- POMOCNÉ FUNKCE (HELPER FUNCTIONS) ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().roles.hasAny([role]);
    }
    
    function hasAnyRole(roles) {
      return isSignedIn() && getUserData().roles.hasAny(roles);
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().isSuperAdmin == true;
    }

    function isMyStudent(studentId) {
        let userData = getUserData();
        return (hasRole('rodic') && (userData.studentId == studentId || (userData.keys().contains('studentIds') && studentId in userData.studentIds))) || (hasRole('ziak') && request.auth.uid == studentId);
    }

    // --- PRAVIDLA PRO KOLEKCE ---

    match /users/{userId} {
      allow get: if isSignedIn() && (
        isOwner(userId) || 
        hasRole('administrator') || 
        isMyStudent(userId) ||
        getUserData().organizationId == resource.data.organizationId
      );
      
      allow list: if isSignedIn();
      
      allow create: if hasRole('administrator');
      allow update: if isOwner(userId) || hasRole('administrator');
      allow delete: if hasRole('administrator');
    }
    
    match /organizations/{organizationId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /grades/{gradeId} {
      allow read: if isSignedIn() && (
        hasAnyRole(['ucitel', 'administrator']) || 
        resource.data.ziakId == request.auth.uid || 
        isMyStudent(resource.data.ziakId)
      );
      allow write: if hasAnyRole(['ucitel', 'administrator']);
    }

    match /tridy/{tridaId} {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
    match /predmety/{predmetId} {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
    match /ucebny/{ucebnaId} {
      allow read: if isSignedIn();
      allow write: if hasRole('administrator');
    }
    
    match /poznamky-zaku/{poznamkaId} {
        allow read: if isSignedIn() && (
          hasAnyRole(['ucitel', 'administrator']) || 
          resource.data.studentId == request.auth.uid || 
          isMyStudent(resource.data.studentId)
        );
        allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
    match /messages/{messageId} {
      allow create: if isSignedIn();
      allow get, list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        request.auth.uid in resource.data.recipientIds ||
        (hasRole('rodic') && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId in resource.data.recipientIds ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds.hasAny(resource.data.recipientIds)))
      );
      allow update: if isSignedIn();
    }
    
    match /rozvrhy/{rozvrhId} {
        allow read: if isSignedIn();
        allow write: if hasRole('administrator');
    }
    
    match /scheduleTemplates/{templateId} {
        allow read: if isSignedIn();
        allow write: if hasRole('administrator');
    }
    
    match /udalosti/{udalostId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /suplovani/{substitutionId} {
        allow read: if isSignedIn();
        allow write: if hasRole('administrator');
    }
    
    match /zapisyHodin/{zapisId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /absences/{absenceId} {
        allow read: if isSignedIn() && (
          hasAnyRole(['ucitel', 'administrator']) || 
          resource.data.studentId == request.auth.uid || 
          isMyStudent(resource.data.studentId)
        );
        allow write: if hasRole('administrator');
    }
    
    match /omluvenky/{omluvenkaId} {
        allow read: if isSignedIn() && (
          hasAnyRole(['ucitel', 'administrator']) || 
          resource.data.studentId == request.auth.uid || 
          isOwner(resource.data.parentId)
        );
        allow write: if isSignedIn();
    }
    
    match /ukoly/{ukolId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /prijimaci-rizeni/{rizeniId} {
        allow create: if true; // Veřejný formulář
        allow read, update, delete: if hasRole('administrator');
    }
    
    match /zaznamy-schuzek/{zaznamId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
     match /oznameni/{oznameniId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
  }
}