
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- POMOCNÉ FUNKCE (HELPER FUNCTIONS) ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().roles.hasAny([role]);
    }
    
    function hasAnyRole(roles) {
      return isSignedIn() && getUserData().roles.hasAny(roles);
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().isSuperAdmin == true;
    }

    // Funkce pro ověření, zda je žák dítětem přihlášeného rodiče
    function isMyStudent(studentId) {
        let parentData = getUserData();
        let sIds = parentData.get('studentIds', []);
        let legacyId = parentData.get('studentId', '');
        return hasRole('rodic') && (studentId in sIds || studentId == legacyId);
    }

    // Funkce pro ověření přístupu ke zprávě (pro rodiče dětí v seznamu příjemců)
    function isParentOfAny(recipientIds) {
        let parentData = getUserData();
        if (!hasRole('rodic')) return false;
        let myStudents = parentData.get('studentIds', []);
        let legacyId = parentData.get('studentId', '');
        
        // Kontrola, zda se ID některého z mých dětí nachází v seznamu příjemců
        return recipientIds.hasAny(myStudents) || (legacyId != '' && legacyId in recipientIds);
    }

    // --- PRAVIDLA PRO KOLEKCE ---

    match /users/{userId} {
      // Umožníme listování všem přihlášeným (pro výběr příjemců), ale výsledky budou filtrovány dotazem
      allow list: if isSignedIn();
      
      // Umožníme číst profil: sobě, adminovi, rodiči (své dítě) nebo komukoli ze stejné školy
      allow get: if isSignedIn() && (
        isOwner(userId) || 
        hasRole('administrator') || 
        isMyStudent(userId) ||
        getUserData().organizationId == resource.data.organizationId
      );
      
      allow create: if hasRole('administrator');
      allow update: if isOwner(userId) || hasRole('administrator');
      allow delete: if hasRole('administrator');
    }
    
    match /organizations/{organizationId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /grades/{gradeId} {
      allow read: if isSignedIn() && (
        hasAnyRole(['ucitel', 'administrator']) || 
        resource.data.ziakId == request.auth.uid || 
        isMyStudent(resource.data.ziakId)
      );
      allow write: if hasAnyRole(['ucitel', 'administrator']);
    }

    match /tridy/{tridaId} {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
    match /predmety/{predmetId} {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
    match /ucebny/{ucebnaId} {
      allow read: if isSignedIn();
      allow write: if hasRole('administrator');
    }
    
    match /poznamky-zaku/{poznamkaId} {
        allow read: if isSignedIn() && (
          hasAnyRole(['ucitel', 'administrator']) || 
          resource.data.studentId == request.auth.uid || 
          isMyStudent(resource.data.studentId)
        );
        allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
    match /messages/{messageId} {
      allow create: if isSignedIn();
      allow get, list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        request.auth.uid in resource.data.recipientIds ||
        isParentOfAny(resource.data.recipientIds)
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.recipientIds || 
        isParentOfAny(resource.data.recipientIds)
      );
    }
    
    match /rozvrhy/{rozvrhId} {
        allow read: if isSignedIn();
        allow write: if hasRole('administrator');
    }
    
    match /scheduleTemplates/{templateId} {
        allow read: if isSignedIn();
        allow write: if hasRole('administrator');
    }
    
    match /udalosti/{udalostId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /suplovani/{substitutionId} {
        allow read: if isSignedIn();
        allow write: if hasRole('administrator');
    }
    
    match /zapisyHodin/{zapisId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /absences/{absenceId} {
        allow read: if isSignedIn() && (
          hasAnyRole(['ucitel', 'administrator']) || 
          resource.data.studentId == request.auth.uid || 
          isMyStudent(resource.data.studentId)
        );
        allow write: if hasRole('administrator');
    }
    
    match /omluvenky/{omluvenkaId} {
        allow read: if isSignedIn() && (
          hasAnyRole(['ucitel', 'administrator']) || 
          resource.data.studentId == request.auth.uid || 
          isOwner(resource.data.parentId)
        );
        allow write: if isSignedIn();
    }
    
    match /ukoly/{ukolId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['administrator', 'ucitel']);
    }
    
    match /prijimaci-rizeni/{rizeniId} {
        allow create: if true; // Veřejný formulář
        allow read, update, delete: if hasRole('administrator');
    }
    
    match /zaznamy-schuzek/{zaznamId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
    
     match /oznameni/{oznameniId} {
        allow read: if isSignedIn();
        allow write: if hasAnyRole(['ucitel', 'administrator']);
    }
  }
}
